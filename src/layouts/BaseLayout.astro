---
import '../styles/global.css';
import { SITE } from '../consts';
import type { Locale, Translations } from '../i18n';
import { homePath, switchLocalePath } from '../i18n';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  locale: Locale;
  t: Translations;
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  locale,
  t,
  title = t.meta.title,
  description = t.meta.description,
  canonicalPath,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const path = canonicalPath ?? (locale === 'en' ? '/en/' : '/');
const siteUrl = Astro.site ?? SITE.url;
const canonicalURL = new URL(path, siteUrl);
const ogImage = new URL('/og-image.png', siteUrl);
const ogLocale = locale === 'en' ? 'en_US' : 'es_ES';
const ogLocaleAlt = locale === 'en' ? 'es_ES' : 'en_US';
const altLocale = locale === 'en' ? 'es' : 'en';
const altPath = switchLocalePath(path, altLocale);
const altURL = new URL(altPath, siteUrl);
const defaultURL = new URL(homePath('es'), siteUrl);
const isHome = path === '/' || path === '/en/' || path === '/en';

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#business`,
  name: SITE.legalName,
  alternateName: SITE.name,
  description: t.meta.description,
  url: SITE.url,
  email: SITE.email,
  ...(SITE.whatsapp ? { telephone: `+${SITE.whatsapp}` } : {}),
  image: ogImage.href,
  logo: new URL('/logo-icon-512.png', siteUrl).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.location.city,
    addressRegion: SITE.location.region,
    addressCountry: SITE.location.country,
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: SITE.location.areaServed },
    { '@type': 'Country', name: 'Spain' },
  ],
  priceRange: '€€',
  founder: {
    '@type': 'Person',
    name: SITE.author,
  },
  ...(SITE.social.linkedin ? { sameAs: [SITE.social.linkedin] } : {}),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: t.meta.description,
  inLanguage: locale === 'en' ? 'en' : 'es',
  publisher: { '@id': `${SITE.url}/#business` },
};

const serviceListSchema = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: t.services.title,
      itemListElement: t.services.items.map((service, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Service',
          name: service.title,
          description: service.description,
          provider: { '@id': `${SITE.url}/#business` },
          areaServed: SITE.location.areaServed,
        },
      })),
    }
  : null;

const jsonLd = [businessSchema, websiteSchema, ...(serviceListSchema ? [serviceListSchema] : [])];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={t.meta.keywords} />
    <meta name="author" content={SITE.author} />
    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}
    <meta name="geo.region" content="ES-CN" />
    <meta name="geo.placename" content={SITE.location.city} />

    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={locale === 'es' ? 'es-ES' : 'en'} href={canonicalURL} />
    <link rel="alternate" hreflang={altLocale === 'es' ? 'es-ES' : 'en'} href={altURL} />
    <link rel="alternate" hreflang="x-default" href={defaultURL} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1e3a8a" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow-lg"
    >
      {t.meta.skipToContent}
    </a>
    <slot />
    {SITE.whatsapp && <WhatsAppFloat locale={locale} t={t} />}
  </body>
</html>
