---
import type { Locale } from '../i18n';
import { switchLocalePath } from '../i18n';

interface Props {
  locale: Locale;
  switchToEn: string;
  switchToEs: string;
}

const { locale, switchToEn, switchToEs } = Astro.props;
const targetPath = locale === 'es' ? switchLocalePath(Astro.url.pathname, 'en') : switchLocalePath(Astro.url.pathname, 'es');
const label = locale === 'es' ? switchToEn : switchToEs;
---

<a
  href={targetPath}
  class="inline-flex h-9 w-9 items-center justify-center overflow-hidden rounded-md border border-slate-200 transition hover:border-slate-300 hover:shadow-sm"
  aria-label={label}
  title={label}
>
  {
    locale === 'es' ? (
      <svg class="h-5 w-7" viewBox="0 0 28 20" aria-hidden="true">
        <rect width="28" height="20" fill="#b22234" />
        <g fill="#fff">
          <rect y="1.54" width="28" height="1.54" />
          <rect y="4.62" width="28" height="1.54" />
          <rect y="7.69" width="28" height="1.54" />
          <rect y="10.77" width="28" height="1.54" />
          <rect y="13.85" width="28" height="1.54" />
          <rect y="16.92" width="28" height="1.54" />
        </g>
        <rect width="11.2" height="10.77" fill="#3c3b6e" />
        <g fill="#fff">
          <circle cx="1.4" cy="1.1" r="0.45" />
          <circle cx="3.5" cy="1.1" r="0.45" />
          <circle cx="5.6" cy="1.1" r="0.45" />
          <circle cx="7.7" cy="1.1" r="0.45" />
          <circle cx="9.8" cy="1.1" r="0.45" />
          <circle cx="2.45" cy="2.5" r="0.45" />
          <circle cx="4.55" cy="2.5" r="0.45" />
          <circle cx="6.65" cy="2.5" r="0.45" />
          <circle cx="8.75" cy="2.5" r="0.45" />
        </g>
      </svg>
    ) : (
      <svg class="h-5 w-7" viewBox="0 0 28 20" aria-hidden="true">
        <rect width="28" height="20" fill="#c60b1e" />
        <rect y="5" width="28" height="10" fill="#ffc400" />
      </svg>
    )
  }
</a>
