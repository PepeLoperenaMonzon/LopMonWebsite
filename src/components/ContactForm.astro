---
import { SITE } from '../consts';

const hasWhatsApp = Boolean(SITE.whatsapp);
---

<section id="contacto" class="border-t border-slate-200 bg-white py-20" aria-labelledby="contacto-heading">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-brand-100 bg-brand-50 p-8 text-center shadow-sm md:p-12">
      <h2 id="contacto-heading" class="mb-4 text-3xl font-bold text-slate-900">
        ¿Tienes un proyecto en mente o un problema que resolver?
      </h2>
      <p class="mb-8 text-lg text-slate-600">
        Trabajamos con presupuestos a medida y bolsas de horas flexibles. Rellena el mensaje y ábrelo en tu correo
        {hasWhatsApp ? ' o por WhatsApp' : ''}.
      </p>

      <form id="contact-form" class="mx-auto max-w-md space-y-4 text-left">
        <div>
          <label for="name" class="mb-1 block text-sm font-medium text-slate-700">Nombre o Empresa</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="organization"
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500"
            placeholder="Ej. Taller Martínez S.L."
          />
        </div>

        <div>
          <label for="contact" class="mb-1 block text-sm font-medium text-slate-700">Email o Teléfono</label>
          <input
            id="contact"
            name="contact"
            type="text"
            required
            autocomplete="email"
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500"
            placeholder="Para que podamos contactarte"
          />
        </div>

        <div>
          <label for="message" class="mb-1 block text-sm font-medium text-slate-700">¿En qué te podemos ayudar?</label>
          <textarea
            id="message"
            name="message"
            rows="3"
            required
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500"
            placeholder="Ej. Necesitamos actualizar nuestro sistema, tenemos un error en la web..."
          ></textarea>
        </div>

        <p class="text-xs text-slate-500">
          Al continuar aceptas nuestra{' '}
          <a href="/privacidad" class="underline hover:text-brand-700">política de privacidad</a>.
        </p>

        <div class={`grid gap-3 ${hasWhatsApp ? 'sm:grid-cols-2' : ''}`}>
          <button
            type="submit"
            data-channel="email"
            class="rounded-lg bg-brand-600 px-4 py-3 font-bold text-white shadow-md transition hover:bg-brand-700"
          >
            Abrir en el correo
          </button>
          {
            hasWhatsApp && (
              <button
                type="submit"
                data-channel="whatsapp"
                class="rounded-lg border border-emerald-600 bg-emerald-600 px-4 py-3 font-bold text-white shadow-md transition hover:bg-emerald-700"
              >
                Abrir en WhatsApp
              </button>
            )
          }
        </div>

        <p class="text-center text-sm text-slate-500">
          O escribe directamente a{' '}
          <a class="font-medium text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ email: SITE.email, whatsapp: SITE.whatsapp }}>
  const form = document.getElementById('contact-form');

  function buildBody(name, contact, message) {
    return [
      `Hola, me pongo en contacto desde la web de LopMon.`,
      ``,
      `Nombre / Empresa: ${name}`,
      `Contacto: ${contact}`,
      ``,
      `Mensaje:`,
      message,
    ].join('\n');
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const submitter = e.submitter;
    const channel = submitter?.getAttribute('data-channel') || 'email';

    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const contact = String(data.get('contact') || '').trim();
    const message = String(data.get('message') || '').trim();
    if (!name || !contact || !message) return;

    const body = buildBody(name, contact, message);

    if (channel === 'whatsapp' && whatsapp) {
      const text = encodeURIComponent(body);
      window.open(`https://wa.me/${whatsapp}?text=${text}`, '_blank', 'noopener,noreferrer');
      return;
    }

    const subject = encodeURIComponent(`Consulta desde la web — ${name}`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${encodeURIComponent(body)}`;
  });
</script>
