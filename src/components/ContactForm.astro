---
import { SITE } from '../consts';
import type { Locale, Translations } from '../i18n';

interface Props {
  locale: Locale;
  t: Translations;
}

const { locale, t } = Astro.props;
const hasWhatsApp = Boolean(SITE.whatsapp);
const privacyHref = locale === 'en' ? '/en/privacy/' : '/privacidad/';
---

<section id="contacto" class="border-t border-slate-200 bg-white py-20" aria-labelledby="contacto-heading">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-brand-100 bg-brand-50 p-8 text-center shadow-sm md:p-12">
      <h2 id="contacto-heading" class="mb-4 text-3xl font-bold text-slate-900">
        {t.contact.title}
      </h2>
      <p class="mb-8 text-lg text-slate-600">
        {t.contact.intro}
        {hasWhatsApp ? t.contact.introWhatsApp : ''}.
      </p>

      <form id="contact-form" class="mx-auto max-w-md space-y-4 text-left">
        <div>
          <label for="name" class="mb-1 block text-sm font-medium text-slate-700">{t.contact.nameLabel}</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="organization"
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500"
            placeholder={t.contact.namePlaceholder}
          />
        </div>

        <div>
          <label for="contact" class="mb-1 block text-sm font-medium text-slate-700">{t.contact.contactLabel}</label>
          <input
            id="contact"
            name="contact"
            type="text"
            required
            autocomplete="email"
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500"
            placeholder={t.contact.contactPlaceholder}
          />
        </div>

        <div>
          <label for="message" class="mb-1 block text-sm font-medium text-slate-700">{t.contact.messageLabel}</label>
          <textarea
            id="message"
            name="message"
            rows="3"
            required
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500"
            placeholder={t.contact.messagePlaceholder}
          ></textarea>
        </div>

        <p class="text-xs text-slate-500">
          {t.contact.privacy}{' '}
          <a href={privacyHref} class="underline hover:text-brand-700">{t.contact.privacyLink}</a>.
        </p>

        <div class={`grid gap-3 ${hasWhatsApp ? 'sm:grid-cols-2' : ''}`}>
          <button
            type="submit"
            data-channel="email"
            class="rounded-lg bg-brand-600 px-4 py-3 font-bold text-white shadow-md transition hover:bg-brand-700"
          >
            {t.contact.emailBtn}
          </button>
          {
            hasWhatsApp && (
              <button
                type="submit"
                data-channel="whatsapp"
                class="rounded-lg border border-emerald-600 bg-emerald-600 px-4 py-3 font-bold text-white shadow-md transition hover:bg-emerald-700"
              >
                {t.contact.whatsappBtn}
              </button>
            )
          }
        </div>

        <p class="text-center text-sm text-slate-500">
          {t.contact.orEmail}{' '}
          <a class="font-medium text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ email: SITE.email, whatsapp: SITE.whatsapp, formIntro: t.contact.formIntro, formFields: t.contact.formFields, emailSubject: t.contact.emailSubject }}>
  const form = document.getElementById('contact-form');

  function buildBody(name, contact, message) {
    return [
      formIntro,
      ``,
      `${formFields.name}: ${name}`,
      `${formFields.contact}: ${contact}`,
      ``,
      `${formFields.message}:`,
      message,
    ].join('\n');
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const submitter = e.submitter;
    const channel = submitter?.getAttribute('data-channel') || 'email';

    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const contact = String(data.get('contact') || '').trim();
    const message = String(data.get('message') || '').trim();
    if (!name || !contact || !message) return;

    const body = buildBody(name, contact, message);

    if (channel === 'whatsapp' && whatsapp) {
      const text = encodeURIComponent(body);
      window.open(`https://wa.me/${whatsapp}?text=${text}`, '_blank', 'noopener,noreferrer');
      return;
    }

    const subject = encodeURIComponent(`${emailSubject} — ${name}`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${encodeURIComponent(body)}`;
  });
</script>
