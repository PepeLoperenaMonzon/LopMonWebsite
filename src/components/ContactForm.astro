---
import { SITE } from '../consts';
import type { Locale, Translations } from '../i18n';

interface Props {
  locale: Locale;
  t: Translations;
}

const { locale, t } = Astro.props;
const privacyHref = locale === 'en' ? '/en/privacy/' : '/privacidad/';
const successPath = locale === 'en' ? '/en/thank-you/' : '/gracias/';
const formAction = locale === 'en' ? '/en/' : '/';
---

<section id="contacto" class="border-t border-slate-200 bg-white py-20" aria-labelledby="contacto-heading">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-brand-100 bg-brand-50 p-8 text-center shadow-sm md:p-12">
      <h2 id="contacto-heading" class="mb-4 text-3xl font-bold text-slate-900">
        {t.contact.title}
      </h2>
      <p class="mb-8 text-lg text-slate-600">
        {t.contact.intro}
      </p>

      <form
        id="contact-form"
        name="contact"
        method="POST"
        action={formAction}
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-success-path={successPath}
        class="mx-auto max-w-md space-y-4 text-left"
      >
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="locale" value={locale} />

        <p class="hidden" aria-hidden="true">
          <label>
            Don't fill this out:
            <input name="bot-field" />
          </label>
        </p>

        <div>
          <label for="name" class="mb-1 block text-sm font-medium text-slate-700">{t.contact.nameLabel}</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="organization"
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500"
            placeholder={t.contact.namePlaceholder}
          />
        </div>

        <div>
          <label for="email" class="mb-1 block text-sm font-medium text-slate-700">{t.contact.contactLabel}</label>
          <input
            id="email"
            name="email"
            type="text"
            required
            autocomplete="email"
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500"
            placeholder={t.contact.contactPlaceholder}
          />
        </div>

        <div>
          <label for="message" class="mb-1 block text-sm font-medium text-slate-700">{t.contact.messageLabel}</label>
          <textarea
            id="message"
            name="message"
            rows="3"
            required
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500"
            placeholder={t.contact.messagePlaceholder}
          ></textarea>
        </div>

        <p class="text-xs text-slate-500">
          {t.contact.privacy}{' '}
          <a href={privacyHref} class="underline hover:text-brand-700">{t.contact.privacyLink}</a>.
        </p>

        <button
          type="submit"
          class="w-full rounded-lg bg-brand-600 px-4 py-3 font-bold text-white shadow-md transition hover:bg-brand-700"
        >
          {t.contact.submitBtn}
        </button>

        <p id="contact-form-error" class="hidden text-center text-sm text-red-600" role="alert"></p>

        <p class="text-center text-sm text-slate-500">
          {t.contact.orEmail}{' '}
          <a class="font-medium text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ successPath, formAction, errorMessage: t.contact.submitError }}>
  const form = document.getElementById('contact-form');
  const errorEl = document.getElementById('contact-form-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl?.classList.add('hidden');

    const body = new URLSearchParams(new FormData(form)).toString();
    const response = await fetch(formAction, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body,
    });

    if (response.ok) {
      window.location.href = successPath;
      return;
    }

    errorEl?.classList.remove('hidden');
    if (errorEl) errorEl.textContent = errorMessage;
  });
</script>
