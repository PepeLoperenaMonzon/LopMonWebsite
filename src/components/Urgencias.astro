---
import type { Locale, Translations } from '../i18n';
import { anchorHref } from '../i18n';

interface Props {
  locale: Locale;
  t: Translations;
}

const { locale, t } = Astro.props;
---

<section id="urgencias" class="border-t border-slate-200 bg-brand-900 py-20 text-white" aria-labelledby="urgencias-heading">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <p class="mb-3 text-sm font-semibold tracking-wide text-brand-400 uppercase">{t.emergencies.label}</p>
        <h2 id="urgencias-heading" class="mb-4 text-3xl font-bold leading-tight md:text-4xl">
          {t.emergencies.title}
        </h2>
        <p class="text-lg leading-relaxed text-slate-300">
          {t.emergencies.intro}
        </p>
      </div>

      <div class="space-y-5 text-base leading-relaxed text-slate-200 md:text-lg">
        <p>{t.emergencies.body}</p>
        <ul class="space-y-3 text-slate-200">
          {t.emergencies.bullets.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand-400" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <a
          href={anchorHref(locale, 'contacto')}
          class="inline-flex rounded-lg bg-white px-6 py-3 font-semibold text-brand-900 transition hover:bg-slate-100"
        >
          {t.emergencies.cta}
        </a>
      </div>
    </div>
  </div>
</section>
