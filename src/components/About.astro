---
import type { Translations } from '../i18n';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section id="sobre-mi" class="border-t border-slate-200 bg-white py-20" aria-labelledby="sobre-mi-heading">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-10 lg:grid-cols-[320px_minmax(0,1fr)]">
      <div class="mx-auto w-full max-w-xs lg:mx-0">
        <img
          src="/selfie.jpeg"
          alt={t.about.imageAlt}
          class="aspect-square w-full rounded-3xl object-cover shadow-lg shadow-slate-200"
          loading="lazy"
        />
      </div>

      <div>
        <p class="mb-3 text-sm font-semibold tracking-wide text-brand-600 uppercase">{t.about.label}</p>
        <h2 id="sobre-mi-heading" class="mb-6 text-3xl font-bold text-slate-900">
          {t.about.title}
        </h2>
        <div class="space-y-4 text-lg leading-relaxed text-slate-600">
          <p>
            {t.about.nameIntro}{' '}
            <strong class="font-semibold text-slate-900">Pepe Loperena</strong>,
            <span class="font-medium text-brand-700"> {t.about.role}</span>. {t.about.paragraphs[0]}
          </p>
          <p>{t.about.paragraphs[1]}</p>
          <p>{t.about.paragraphs[2]}</p>
        </div>
      </div>
    </div>
  </div>
</section>
