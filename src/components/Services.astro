---
const services = [
  {
    title: 'Incidencias y soporte del día a día',
    description:
      'Cuando algo falla y tu operativa se frena, actúo rápido para localizar el problema y devolver la normalidad.',
    items: ['Resolución de bloqueos e incidencias', 'Soporte puntual, bolsa de horas o urgencias 24h'],
    iconBg: 'bg-blue-100',
    iconColor: 'text-brand-600',
    icon: 'support',
    featured: false,
  },
  {
    title: 'Web y procesos que impulsan tu negocio',
    description:
      'Si tu web no convierte o repites tareas que te quitan tiempo, diseño mejoras concretas para que tu negocio funcione mejor.',
    items: ['Webs corporativas y mejoras orientadas a resultados', 'Automatizaciones y herramientas internas a medida'],
    iconBg: 'bg-indigo-100',
    iconColor: 'text-indigo-600',
    icon: 'code',
    featured: true,
  },
  {
    title: 'Seguridad y continuidad',
    description:
      'Reviso riesgos, ordeno sistemas y dejo todo preparado: copias, accesos, organización y prevención.',
    items: ['Copias de seguridad y control de accesos', 'Mantenimiento y mejoras continuas'],
    iconBg: 'bg-orange-100',
    iconColor: 'text-orange-600',
    icon: 'alert',
    featured: false,
  },
] as const;
---

<section id="servicios" class="bg-slate-50 py-20" aria-labelledby="servicios-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 text-center">
      <h2 id="servicios-heading" class="mb-4 text-3xl font-bold text-slate-900">Esto es lo que resuelvo</h2>
      <p class="mx-auto max-w-2xl text-lg text-slate-600">
        Trabajo con empresas que necesitan resolver algo concreto ahora y mantener su tecnología al día sin contratar en
        plantilla.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        services.map((service) => (
          <article class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition duration-300 hover:shadow-lg">
            {service.featured && (
              <p class="absolute top-0 right-0 rounded-bl-lg bg-brand-600 px-3 py-1 text-xs font-bold text-white">
                MÁS SOLICITADO
              </p>
            )}
            <div class={`mb-6 flex h-14 w-14 items-center justify-center rounded-xl ${service.iconBg}`}>
              {service.icon === 'support' && (
                <svg class={`h-7 w-7 ${service.iconColor}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.75"
                    d="M4.5 12a7.5 7.5 0 1 1 15 0v3a2.25 2.25 0 0 1-2.25 2.25H15a.75.75 0 0 1-.75-.75v-3A.75.75 0 0 1 15 12.75h3M4.5 15.75h3A.75.75 0 0 0 8.25 15v-1.5a.75.75 0 0 0-.75-.75h-3m7.5 6.75h1.5"
                  />
                </svg>
              )}
              {service.icon === 'code' && (
                <svg class={`h-7 w-7 ${service.iconColor}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
                </svg>
              )}
              {service.icon === 'alert' && (
                <svg class={`h-7 w-7 ${service.iconColor}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.75"
                    d="M12 9v3.75m0 3h.008v.008H12v-.008Zm8.25-.75c0 4.556-3.694 8.25-8.25 8.25S3.75 16.806 3.75 12.25 7.444 4 12 4s8.25 3.694 8.25 8.25Z"
                  />
                </svg>
              )}
            </div>
            <h3 class="mb-3 text-xl font-bold text-slate-900">{service.title}</h3>
            <p class="mb-4 leading-relaxed text-slate-600">{service.description}</p>
            <ul class="space-y-2 text-sm text-slate-600">
              {service.items.map((item) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-green-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
