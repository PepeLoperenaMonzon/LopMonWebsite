---
import type { Locale, Translations } from '../i18n';
import { anchorHref } from '../i18n';

interface Props {
  locale: Locale;
  t: Translations;
}

const { locale, t } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-900 text-white" aria-labelledby="hero-heading">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
    <svg class="h-full w-full" fill="none" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path d="M0 100 L100 0 L100 100 Z" fill="currentColor"></path>
    </svg>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-32 lg:px-8">
    <div class="md:w-2/3">
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-700 bg-brand-800 px-4 py-1.5 text-sm font-medium text-brand-100">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
        </span>
        {t.hero.badge}
      </p>

      <h1 id="hero-heading" class="mb-6 text-4xl font-bold leading-tight md:text-5xl lg:text-6xl">
        {t.hero.title} <span class="text-brand-400">{t.hero.titleHighlight}</span>
      </h1>

      <p class="mb-8 max-w-2xl text-lg text-slate-300 md:text-xl">
        {t.hero.subtitle}
      </p>

      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href={anchorHref(locale, 'contacto')}
          class="rounded-lg bg-white px-8 py-3.5 text-center text-lg font-semibold text-brand-900 shadow-lg transition hover:bg-slate-100"
        >
          {t.hero.ctaPrimary}
        </a>
        <a
          href={anchorHref(locale, 'servicios')}
          class="rounded-lg border border-brand-400 px-8 py-3.5 text-center text-lg font-medium text-brand-100 transition hover:bg-brand-800 hover:text-white"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>
  </div>
</section>
