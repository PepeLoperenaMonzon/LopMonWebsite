---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-900 py-12 text-slate-400">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 sm:px-6 md:flex-row lg:px-8">
    <div class="flex flex-col items-center gap-4 md:items-start">
      <a href="/" class="flex items-center gap-2 text-white" aria-label="LopMon — Inicio">
        <svg class="h-6 w-6 text-brand-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7L12 2.5Zm0 2.3L5.5 8.2v7.6L12 19.2l6.5-3.4V8.2L12 4.8Z"
          ></path>
        </svg>
        <span class="text-xl font-bold">{SITE.name}</span>
      </a>
      <nav class="flex flex-wrap justify-center gap-4 text-sm md:justify-start" aria-label="Legal">
        <a href="/aviso-legal" class="transition hover:text-white">Aviso legal</a>
        <a href="/privacidad" class="transition hover:text-white">Privacidad</a>
        <a href={`mailto:${SITE.email}`} class="transition hover:text-white">{SITE.email}</a>
      </nav>
    </div>
    <div class="text-center text-sm md:text-right">
      <p>&copy; {year} {SITE.legalName}.</p>
      <p>{SITE.location.city}, {SITE.location.region}.</p>
    </div>
  </div>
</footer>
