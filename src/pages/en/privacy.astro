---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../consts';
import { getTranslations } from '../../i18n';

const locale = 'en';
const t = getTranslations(locale);
---

<BaseLayout
  locale={locale}
  t={t}
  title={`${t.legal.privacyTitle} | ${SITE.name}`}
  description={`Privacy policy for ${SITE.legalName}. How we handle personal data.`}
  canonicalPath="/en/privacy"
  noindex={true}
>
  <Header locale={locale} t={t} />
  <main id="contenido" class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="mb-8 text-3xl font-bold text-slate-900">{t.legal.privacyTitle}</h1>
    <div class="space-y-6 text-slate-700">
      <section>
        <h2 class="mb-2 text-xl font-semibold text-slate-900">1. Data controller</h2>
        <ul class="list-disc space-y-1 pl-5">
          <li>Controller: [Full name or company name] — {SITE.legalName}</li>
          <li>Contact email: <a class="text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li>Address: [Address], {SITE.location.city}, {SITE.location.region}</li>
        </ul>
      </section>
      <section>
        <h2 class="mb-2 text-xl font-semibold text-slate-900">2. Data we collect</h2>
        <p>Through the contact form we may process: name or company, email or phone, and your message.</p>
      </section>
      <section>
        <h2 class="mb-2 text-xl font-semibold text-slate-900">3. Purpose and legal basis</h2>
        <p>We process your data to respond to your inquiry and, where applicable, prepare a quote or provide requested services under GDPR consent and/or pre-contractual measures.</p>
      </section>
      <section>
        <h2 class="mb-2 text-xl font-semibold text-slate-900">4. Retention</h2>
        <p>We retain data as long as needed to handle the inquiry and, if no commercial relationship follows, for a maximum of [period, e.g. 1 year].</p>
      </section>
      <section>
        <h2 class="mb-2 text-xl font-semibold text-slate-900">5. Recipients</h2>
        <p>The contact form opens your email app or WhatsApp with a pre-filled message; data travels directly between you and us. We do not sell your data.</p>
      </section>
      <section>
        <h2 class="mb-2 text-xl font-semibold text-slate-900">6. Rights</h2>
        <p>You may exercise access, rectification, erasure, objection, restriction and portability rights by writing to <a class="text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      </section>
      <section>
        <h2 class="mb-2 text-xl font-semibold text-slate-900">7. Cookies</h2>
        <p>This site does not use analytics or advertising cookies by default.</p>
      </section>
    </div>
  </main>
  <Footer locale={locale} t={t} />
</BaseLayout>
