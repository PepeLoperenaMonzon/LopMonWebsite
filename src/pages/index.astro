import Urgencias from '../components/Urgencias.astro';
import About from '../components/About.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="contenido">
    <Hero />
    <Services />
    <Urgencias />
    <About />
    <ContactForm />
  </main>
  <Footer />
</BaseLayout>
